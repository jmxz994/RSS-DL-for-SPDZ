from Compiler import ml
from functools import reduce
from operator import mul
import mpc_math

n_thread = 4

def transpose(x, perm=None):
    # mostly used for 6-D Matrix

    x_shape = x.shape
    x_shape_len = len(x_shape)
    assert x_shape_len <= 6 and x_shape_len > 1, "x_shape_len must <= 6 and > 1"
    new_shape = []
    if perm is None:
        perm = []
        for i in range(x_shape_len):
            perm.append(x_shape_len - 1 - i)

    assert len(perm) == x_shape_len, "perm's length must equal to x.shape's length"

    for i in range(x_shape_len):
        new_shape.append(x_shape[perm[i]])

    y = x.value_type.Tensor(new_shape)

    if x_shape_len == 2:
        index_list = [0, 0]
        for i1 in range(x_shape[0]):
            for i2 in range(x_shape[1]):
                y[i2][i1] = x[i1][i2]
    elif x_shape_len == 3:
        index_list = [0, 0, 0]
        i = [0, 0, 0]
        for i[0] in range(x_shape[0]):
            for i[1] in range(x_shape[1]):
                for i[2] in range(x_shape[2]):
                    for j in range(3):
                        index_list[j] = i[perm[j]]
                    y[index_list[0]][index_list[1]][index_list[2]] = x[i[0]][i[1]][i[2]]
    elif x_shape_len == 4:
        index_list = [0, 0, 0, 0]
        i = [0, 0, 0, 0]
        for i[0] in range(x_shape[0]):
            for i[1] in range(x_shape[1]):
                for i[2] in range(x_shape[2]):
                    for i[3] in range(x_shape[3]):
                        for j in range(4):
                            index_list[j] = i[perm[j]]
                        y[index_list[0]][index_list[1]][index_list[2]][index_list[3]] = x[i[0]][i[1]][i[2]][i[3]]
    elif x_shape_len == 5:
        index_list = [0, 0, 0, 0, 0]
        i = [0, 0, 0, 0, 0]
        for i[0] in range(x_shape[0]):
            for i[1] in range(x_shape[1]):
                for i[2] in range(x_shape[2]):
                    for i[3] in range(x_shape[3]):
                        for i[4] in range(x_shape[4]):
                            for j in range(5):
                                index_list[j] = i[perm[j]]
                            y[index_list[0]][index_list[1]][index_list[2]][index_list[3]][index_list[4]] = x[i[0]][i[1]][i[2]][i[3]][i[4]]
    elif x_shape_len == 6:
        index_list = [0, 0, 0, 0, 0, 0]
        i = [0, 0, 0, 0, 0, 0]
        for i[0] in range(x_shape[0]):
            for i[1] in range(x_shape[1]):
                for i[2] in range(x_shape[2]):
                    for i[3] in range(x_shape[3]):
                        for i[4] in range(x_shape[4]):
                            for i[5] in range(x_shape[5]):
                                for j in range(6):
                                    index_list[j] = i[perm[j]]
                                y[index_list[0]][index_list[1]][index_list[2]][index_list[3]][index_list[4]][index_list[5]] = x[i[0]][i[1]][i[2]][i[3]][i[4]][i[5]]
    return y

def reshape(x, new_shape=[]):
    new_shape = list(new_shape)
    neg_count = new_shape.count(-1)  # count(): Counting the number of -1's
    assert neg_count <= 1, "new_shape has more than one -1"

    x_shape = x.shape

    x_elements = reduce(mul, x_shape)
    assert x_elements % abs(reduce(mul, new_shape)) == 0, "new_shape {} no match the x_shape {}".format(new_shape,
                                                                                                        x_shape)

    if neg_count > 0:
        new_shape[new_shape.index(-1)] = x_elements // abs(reduce(mul, new_shape))

    assert reduce(mul, new_shape) == x_elements, "new_shape must equal to x.shape"

    y = x.value_type.Tensor(new_shape)
    y.assign(x)

    return y

def gelu(x):
    return x*ml.approx_sigmoid(x*1.702)

def layer_norm(input, epsilon=1e-6, recursion=False):
    k = input.shape[-1]
    input_shape_len = len(input.shape)

    input_normalized = input.same_shape()

    global n_thread

    if input_shape_len == 1 and not recursion:
        @map_sum_opt(n_thread, k, [sfix])
        def opt_mean_sum(i):
            return input[i]

        mem_mean_i = MemValue(opt_mean_sum() / k)  # transform the register value to memeory value
        print_ln("mem_mean_i:%s", mem_mean_i.reveal())

        @map_sum_opt(n_thread, k, [sfix])
        def opt_var_sum(i):
            return (input[i] - mem_mean_i) ** 2

        var_i = opt_var_sum() / k
        print_ln("var_i:%s", var_i.reveal())

        v_inv_s = MemValue(mpc_math.InvertSqrt(var_i + epsilon))
        print_ln("v_inv_s:%s", v_inv_s.reveal())

        @for_range_opt_multithread(n_thread, k)
        def _(i):
            input_normalized[i] = (input[i] - mem_mean_i) * v_inv_s

        return input_normalized
    elif input_shape_len == 1 and recursion:
        mem_mean_i = sum([input[i] for i in range(k)]) / k  # transform the register value to memeory value

        var_i = sum([((input[i] - mem_mean_i) ** 2) for i in range(k)]) / k

        v_inv_s = mpc_math.InvertSqrt(var_i + epsilon)

        for i in range(k):
            input_normalized[i] = (input[i] - mem_mean_i) * v_inv_s

        return input_normalized
    elif input_shape_len == 2:
        # epsilon = MemValue(sfix(epsilon))
        @for_range_opt_multithread(n_thread, input.shape[0])
        def _(i):
            input_normalized[i].assign(layer_norm(input[i], epsilon, True))

        return input_normalized
    elif input_shape_len == 3:
        @for_range_opt_multithread(n_thread, input.shape[0:-1])
        def _(i, j):
            input_normalized[i][j].assign(layer_norm(input[i][j], epsilon, True))

        return input_normalized
    elif input_shape_len == 4:
        @for_range_opt_multithread(n_thread, input.shape[0:-1])
        def _(i, j, k):
            input_normalized[i][j][k].assign(layer_norm(input[i][j][k], epsilon, True))

        return input_normalized

'''
class CustomDenseLayer:
    def __init__(self, units, input_dim):
        self.units = units
        self.input_dim = input_dim

        self.w = sfix.Tensor([input_dim, units])  # 权重矩阵形状 (input_dim, units)
        self.b = sfix.Tensor([1, units])  # 偏置向量形状 (units,)

    def Dense(self, inputs):
        # 从指定文件中读取权重和偏置
        self.w.input_from(0)
        self.b.input_from(0)
        # 实现矩阵乘法和加法
        return inputs.dot(self.w) + self.b


class CustomConv2DLayer:
    def __init__(self, filters, kernel_size, strides=(1, 1), padding='VALID', input_shape=None):
        self.filters = filters
        self.kernel_size = kernel_size
        self.strides = strides
        self.padding = padding
        self.input_shape = input_shape

        # 预定义卷积核和偏置的大小
        self.kernels = sfix.Tensor(
            [filters, input_shape[2], *kernel_size])  # 卷积核形状 (filters, channels, kernel_height, kernel_width)
        self.biases = sfix.Tensor([1, filters])  # 偏置的形状 (filters,)

        self.kernels.input_from(0)
        self.biases.input_from(0)

    def apply_padding(self, inputs):
        if self.padding == 'SAME':
            pad_height = (self.kernel_size[0] - 1) // 2
            pad_width = (self.kernel_size[1] - 1) // 2

            padded_height = inputs.shape[0] + 2 * pad_height
            padded_width = inputs.shape[1] + 2 * pad_width

            padded_inputs = sfix.Tensor((padded_height, padded_width, inputs.shape[2]))
            padded_inputs[pad_height:pad_height + inputs.shape[0], pad_width:pad_width + inputs.shape[1], :] = inputs

            return padded_inputs
        else:
            return inputs

    def elementwise_multiply_and_sum(self, region, kernel):
        result = 0.0
        for i in range(region.shape[0]):
            for j in range(region.shape[1]):
                result += region[i, j] * kernel[i, j]
        return result

    def Conv2d(self, inputs):
        inputs = self.apply_padding(inputs)
        input_height, input_width, _ = inputs.shape
        kernel_height, kernel_width = self.kernel_size
        stride_height, stride_width = self.strides

        output_height = (input_height - kernel_height) // stride_height + 1
        output_width = (input_width - kernel_width) // stride_width + 1
        output = sfix.Tensor([output_height, output_width, self.filters])

        # 对每个过滤器进行卷积操作
        for i in range(self.filters):
            for h in range(0, output_height):
                for w in range(0, output_width):
                    for c in range(self.input_shape[2]):
                        # 提取输入的子区域并与卷积核进行点积运算
                        h_start = h * stride_height
                        w_start = w * stride_width
                        region = inputs[h_start:h_start + kernel_height, w_start:w_start + kernel_width, c]
                        output[h, w, i] += self.elementwise_multiply_and_sum(region, self.kernels[i, c])
            # 加上偏置
            output[:, :, i] += self.biases[i]

        return output

'''
class PatchEmbed:
    def __init__(self, img_size, patch_size = 4, embed_dim = 96):
        self.img_size = img_size
        self.patch_size = patch_size
        self.embed_dim = embed_dim

        self.num_patches = (img_size[0] // patch_size) * (img_size[1] // patch_size)

    def forward(self, x):
        self.weight = sfix.Tensor([embed_dim, patch_size * patch_size * 3])
        self.bias = sfix.Tensor([1, embed_dim])
        self.weight.input_from(0)
        self.bias.input_from(0)
        B, H, W, C = x.shape
        patch_height, patch_width = self.patch_size
        num_patches_per_image = (H // patch_height) * (W // patch_width)

        processed_images = sfix.Tensor([B, H, W, C])

        patches = sfix.Tensor([num_patches_per_image, patch_height * patch_width * C])

        for b in range(B):
            patch_idx = 0
            for i in range(0, H, patch_height):
                for j in range(0, W, patch_width):
                    patch = x[b, i:i + patch_height, j:j + patch_width, :].reshape(-1)
                    patches[patch_idx] = patch
                    patch_idx += 1

        # 将每个 patch 映射到嵌入维度
        patch_embeddings = patches.dot(self.weight.T) + self.bias

        # 将嵌入向量还原为图像块，并合并成完整的图像
        patch_idx = 0
        for i in range(0, H, patch_height):
            for j in range(0, W, patch_width):
                patch_processed = patch_embeddings[patch_idx].reshape(patch_height, patch_width, C)
                processed_images[b, i:i + patch_height, j:j + patch_width, :] = patch_processed
                patch_idx += 1

        return processed_images

def window_partition(x, window_size):
    B, H, W, C = x.shape
    x = reshape(x, [B, H // window_size, window_size, W // window_size, window_size, C])
    # transpose: [B, H//Mh, Mh, W//Mw, Mw, C] -> [B, H//Mh, W//Mh, Mw, Mw, C]
    # reshape: [B, H//Mh, W//Mw, Mh, Mw, C] -> [B*num_windows, Mh, Mw, C]
    x = transpose(x, [0, 1, 3, 2, 4, 5])
    windows = reshape(x, [-1, window_size, window_size, C])
    return windows

def window_reverse(windows, window_size, H, W):
    B = (windows.shape[0] / (H * W / window_size / window_size))
    # reshape: [B*num_windows, Mh, Mw, C] -> [B, H//Mh, W//Mw, Mh, Mw, C]
    x = reshape(windows, [B, H // window_size, W // window_size, window_size, window_size, -1])
    # permute: [B, H//Mh, W//Mw, Mh, Mw, C] -> [B, H//Mh, Mh, W//Mw, Mw, C]
    # reshape: [B, H//Mh, Mh, W//Mw, Mw, C] -> [B, H, W, C]
    x = transpose(x, [0, 1, 3, 2, 4, 5])
    x = reshape(x, [B, H, W, -1])
    return x


class PatchMerging:
    def __init__(self, input_dim):
        self.input_dim = input_dim
        self.output_dim = input_dim * 2  # 每个 2x2 的区域合并后，通道数加倍

    def forward(self, x):
        self.weight = sfix.Tensor([4 * self.input_dim, self.output_dim])
        self.bias = sfix.Tensor([1, self.output_dim])
        self.weight.input_from(0)
        self.bias.input_from(0)
        B, H, W, C = x.shape
        assert H % 2 == 0 and W % 2 == 0, "Height and Width must be even."

        # 重塑和合并相邻的 2x2 patches
        x = reshape(x, [B, H // 2, 2, W // 2, 2, C])
        x = transpose(x, [0, 1, 3, 2, 4, 5])
        x = reshape(x, [B, H // 2, W // 2, 4 * C])  # 将每个 2x2 区域展平

        x = x.dot(self.weight) + self.bias

        return x

class MLP:
    def __init__(self, input_dim, hidden_dim, output_dim):
        self.input_dim = input_dim
        self.hidden_dim = hidden_dim
        self.output_dim = output_dim

    def gelu(self, x):
        return x * ml.approx_sigmoid(x * 1.702)

    def forward(self, x):
        #self.fc1_weight = sfix.Tensor(input_dim, hidden_dim) * 0.02
        self.fc1_weight = sfix.Tensor([self.input_dim, self.hidden_dim])
        self.fc1_bias = sfix.Tensor([1, self.hidden_dim])
        #self.fc2_weight = sfix.Tensor(hidden_dim, output_dim) * 0.02
        self.fc2_weight = sfix.Tensor([self.hidden_dim, self.output_dim])
        self.fc2_bias = sfix.Tensor([1, self.output_dim])

        #从读取便时乘0.02
        self.fc1_weight.input_from(0)
        self.fc1_bias.input_from(0)
        self.fc2_weight.input_from(0)
        self.fc2_bias.input_from(0)
        # 第一个全连接层 + 激活函数 GeLU
        x = x.dot(self.fc1_weight) + self.fc1_bias
        x = self.gelu(x)

        # 第二个全连接层
        x = x.dot(self.fc2_weight) + self.fc2_bias

        return x


class WindowAttention:
    def __init__(self, dim, window_size, num_heads = 8, qkv_bias=True):
        self.dim = dim
        self.window_size = window_size
        self.num_heads = num_heads
        self.head_dim = dim // num_heads
        self.scale = self.head_dim ** -0.5
    """    
    def softmax(self, x, axis=-1):
        exp_x = np.exp(x - np.max(x, axis=axis, keepdims=True))
        return exp_x / np.sum(exp_x, axis=axis, keepdims=True)
    """

    def forward(self, x):
        # 初始化查询、键、值的线性变换权重
        self.qkv_weight = sfix.Tensor([3 * self.dim, self.dim])   # * 0.02
        self.qkv_bias = sfix.Tensor([1, 3 * self.dim])
        self.qkv_weight.input_from(0)
        self.qkv_bias.input_from(0)

        # 输出的线性变换权重
        self.proj_weight = sfix.Tensor([self.dim, self.dim])   # * 0.02
        self.proj_bias = sfix.Tensor([1, self.dim])
        self.proj_weight.input_from(0)
        self.proj_bias.input_from(0)
        B_, N, C = x.shape

        # 计算 Q, K, V
        qkv = x.dot(self.qkv_weight.T)
        if self.qkv_bias is not None:
            qkv += self.qkv_bias

        qkv = qkv.reshape(B_, N, 3, self.num_heads, self.head_dim).transpose(2, 0, 3, 1, 4)
        q, k, v = qkv[0], qkv[1], qkv[2]

        # 计算注意力分数
        attn = q.dot(k.transpose(0, 1, 3, 2)) * self.scale
        attn = ml.softmax(attn, axis=-1)

        # 计算注意力输出
        x = attn.dot(v)
        x = x.transpose(0, 2, 1, 3).reshape(B_, N, C)

        # 最后一次线性变换
        x = x.dot(self.proj_weight.T) + self.proj_bias

        return x

class SwinTransformerBlock:
    def __init__(self, dim, input_resolution, num_heads, window_size=7, mlp_ratio=4., qkv_bias=True):
        self.dim = dim
        self.input_resolution = input_resolution
        self.num_heads = num_heads
        self.window_size = window_size
        self.mlp_ratio = mlp_ratio

        # LayerNorm 层
        #self.norm1 = LayerNorm(dim)
        #self.norm2 = LayerNorm(dim)

        # Window Attention 层
        self.attn = WindowAttention(dim, window_size=(window_size, window_size), num_heads=num_heads, qkv_bias=qkv_bias)

        # MLP 层
        hidden_dim = dim * mlp_ratio
        self.mlp = MLP(dim, hidden_dim, dim)

    def forward(self, x):
        B, L, C = x.shape
        H, W = self.input_resolution

        assert L == H * W, "Input feature has wrong size"

        # 1. LayerNorm + WindowAttention
        x = x.reshape(B, H, W, C)
        x_windows = window_partition(x, self.window_size)  # 将输入划分为多个窗口
        x_windows = x_windows.reshape(-1, self.window_size * self.window_size,
                                      C)  # (B*num_windows, window_size*window_size, C)

        attn_windows = self.attn.forward(x_windows)  # 执行窗口内的多头注意力
        attn_windows = attn_windows.reshape(-1, self.window_size, self.window_size, C)

        x = window_reverse(attn_windows, self.window_size,H, W)  # 将窗口恢复到原始输入形状
        x = x.reshape(B, H * W, C)

        # 2. 残差连接
        x = layer_norm(x) + x

        # 3. MLP
        x = self.mlp.forward(x)

        # 4. 残差连接
        x = layer_norm(x) + x

        return x


class BasicLayer:
    def __init__(self, dim, input_resolution, depth, num_heads, window_size=7, mlp_ratio=4., qkv_bias=True,
                downsample=None):
        self.dim = dim
        self.input_resolution = input_resolution
        self.depth = depth
        self.window_size = window_size
        self.downsample = downsample

        # 创建多个 SwinTransformerBlock
        self.blocks = [
            SwinTransformerBlock(
                dim=dim,
                input_resolution=input_resolution,
                num_heads=num_heads,
                window_size=window_size,
                mlp_ratio=mlp_ratio,
                qkv_bias=qkv_bias
            )
            for _ in range(depth)
        ]

        # Patch Merging
        if downsample is not None:
            self.downsample = PatchMerging(input_dim=dim)

        # 创建注意力掩码
        self.attn_mask = self.create_mask(input_resolution, window_size)

    def create_mask(self, input_resolution, window_size):
        H, W = input_resolution
        img_mask = sfix.Tensor([1, H, W, 1])  # 初始掩码矩阵

        cnt = 0
        for h in range(H // window_size):
            for w in range(W // window_size):
                # 填充mask区域 (h_start, h_end) 和 (w_start, w_end)
                for i in range(h * window_size, (h + 1) * window_size):
                    for j in range(w * window_size, (w + 1) * window_size):
                        img_mask[0][i][j][0] = cnt
                cnt += 1

        # 分割窗口并计算差异掩码
        mask_windows = window_partition(img_mask, window_size)
        mask_windows = reshape(mask_windows, [-1, window_size * window_size])

        attn_mask = sfix.Tensor([mask_windows.shape[0], mask_windows.shape[1], mask_windows.shape[1]])

        for i in range(mask_windows.shape[0]):
            for j in range(mask_windows.shape[1]):
                for k in range(mask_windows.shape[1]):
                    condition = mask_windows[i][j] != mask_windows[i][k]
                    attn_mask[i][j][k] = sfix(-100.0) * condition  # 这里不再直接使用if语句，而是将条件作为一个操作数
                    attn_mask[i][j][k] += (1 - condition) * sfix(0.0)

        return attn_mask

    def forward(self, x):
        for blk in self.blocks:
            x = blk.forward(x)

        if self.downsample is not None:
            x = x.reshape(-1, *self.input_resolution, self.dim)
            x = self.downsample.forward(x)
            new_resolution = (self.input_resolution[0] // 2, self.input_resolution[1] // 2)
            x = reshape(x, [-1, new_resolution[0] * new_resolution[1], self.dim * 2])

        return x


class SwinTransformer:
    def __init__(self, img_size=224, patch_size=4, in_chans=3, num_classes=1000,
                 embed_dim=96, depths=[2, 2, 6, 2], num_heads=[3, 6, 12, 24],
                 window_size=7, mlp_ratio=4., qkv_bias=True, dropout_rate=0.1):
        self.num_classes = num_classes
        self.num_layers = len(depths)
        self.embed_dim = embed_dim
        self.num_features = embed_dim * 2 ** (self.num_layers - 1)

        # Patch Embedding
        self.patch_embed = PatchEmbed(img_size=(img_size, img_size), patch_size=patch_size,
                                      embed_dim=embed_dim)

        # 基础层的实现
        self.layers = []
        for i_layer in range(self.num_layers):
            layer = BasicLayer(
                dim=int(embed_dim * 2 ** i_layer),
                input_resolution=(img_size // (2 ** i_layer), img_size // (2 ** i_layer)),
                depth=depths[i_layer],
                num_heads=num_heads[i_layer],
                window_size=window_size,
                mlp_ratio=mlp_ratio,
                qkv_bias=qkv_bias,
                downsample=PatchMerging if (i_layer < self.num_layers - 1) else None
            )
            self.layers.append(layer)

        # 分类头部
        #self.norm = LayerNorm(self.num_features)
        self.head = sfix.Tensor([self.num_features, num_classes]) # * 0.02
        self.head_bias = sfix.Tensor([1, num_classes])

    def forward(self, x):
        """
        x:(B, H, W, C)
        """
        # Patch Embedding
        x = self.patch_embed.forward(x)
        x = x.reshape(x.shape[0], -1, x.shape[2])

        # 基础层
        for layer in self.layers:
            x = layer.forward(x)

        # 分类头
        x = layer_norm(x)
        #x = np.mean(x, axis=1)  # Global Average Pooling
        B, N, C = x.shape
        mean_x = sfix.Tensor([B, C])  # 初始化均值数组

        for b in range(B):
            for c in range(C):
                sum_value = 0.0
                for n in range(N):
                    sum_value += x[b][n][c]
                mean_x[b][c] = sum_value / N  # 计算均值

        x = mean_x.dot(self.head) + self.head_bias

        return x
#预测
B = 1
H = W = 224
patch_size = 4
C = 3
num_classes = 1000  # 分类类别数量
embed_dim = 96  # 基础嵌入维度
depths = [2, 2, 6, 2]  # 每个阶段的层数
num_heads = [3, 6, 12, 24]  # 每个阶段的注意力头数量
window_size = 7  # 窗口大小
mlp_ratio = 4.  # MLP 中隐藏层的比例

swin_transformer = SwinTransformer(
    img_size=H,
    patch_size=patch_size,
    in_chans=C,
    num_classes=num_classes,
    embed_dim=embed_dim,
    depths=depths,
    num_heads=num_heads,
    window_size=window_size,
    mlp_ratio=mlp_ratio
)

x = sfix.Tensor([B, H, W, C])

x.input_from(1)

output = swin_transformer.forward(x)    #(b, num_classes)

found_index = regint(0)  # 用来存储找到的索引
for i in range(1000):
    is_one = (output[0][i] == sfix(1.0))  # 检查是否为 1.0
    found_index = found_index + is_one * i  # 如果找到 1.0，则累加当前索引值

# 打印输出找到的索引
print_ln("The class is %s", found_index.reveal())
#预测完毕，输出第几个分类

























