'''
def flatten_patch(patch):
    flattened = []
    for row in patch:
        for pixel in row:
            flattened.extend(pixel)
    return flattened

def extract_patches(x, patch_height, patch_width, B, H, W, C):
    new_H = (H - patch_height) // patch_height + 1
    new_W = (W - patch_width) // patch_width + 1
    
    patches_list = []
    for b in range(B):
        for i in range(new_H):
            for j in range(new_W):
                patch = []
                for m in range(patch_height):
                    for n in range(patch_width):
                        for c in range(C):
                            patch.append(x[b, i * patch_height + m, j * patch_width + n, c])
                patches_list.append(flatten_patch(patch))
    
    patches_shape = [B, new_H, new_W, patch_height * patch_width * C]
    patches = sfix.Tensor(patches_shape)
    
    for idx, patch in enumerate(patches_list):
        b = idx // (new_H * new_W)
        remaining = idx % (new_H * new_W)
        i = remaining // new_W
        j = remaining % new_W
        for k in range(len(patch)):
            patches[b, i, j, k] = patch[k]
        
    return patches

def a():
    B, H, W, C = 1, 224, 224, 3
    patch_size=4
    embed_dim=96
    x = sfix.Tensor([B, H, W, C])
    x.assign_all(0)
    #strides = patch_size
    #output_height = H//strides
    #output_width = W//strides
    #conv_output_shape = (B, output_height, output_width, self.filters)
    #x = reshape(x, [B, -1])
    patch_height = patch_width = patch_size
    layerss = [ml.keras.layers.Dense(embed_dim)]
    proj = ml.keras.models.Sequential(layerss)
    patches = extract_patches(x, patch_height, patch_width, B, H, W, C)
    patches = reshape(patches, (B, -1, patch_height * patch_width * C))
    proj.build((patches.shape))
    for var in proj.trainable_variables:
        var.input_from(0)
    global start 
    for var in proj.trainable_variables:
        start = var.read_from_file(start)
    x = proj.predict(patches)

    return x

a()




























































